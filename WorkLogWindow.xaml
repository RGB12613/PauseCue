<Window x:Class="PauseCue.WorkLogWindow"
        Icon="pack://application:,,,/PauseCue.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="作業ログ - Pause Cue" Height="760" Width="820" MinHeight="600" MinWidth="680"
        Background="#F4F6FB" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#68738A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.06" Color="#263452" /></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#20283A" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="38" />
        </Style>
    </Window.Resources>
    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <StackPanel>
                <TextBlock Text="作業ログ" FontSize="26" FontWeight="Bold" Foreground="#20283A" />
                <TextBlock Text="いつ、どれくらい作業していたかを振り返れます" Margin="0,4,0,0" Foreground="#68738A" FontSize="13" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="CSV ファイルを開く" Click="OpenCsvClicked" Padding="12,8"
                    ToolTip="記録の元データ (work-log.csv) を既定のアプリで開きます" />
        </Grid>

        <!-- Day navigation -->
        <Grid Grid.Row="1" Margin="0,20,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="◀" Style="{StaticResource NavButton}" Click="PreviousDayClicked" ToolTip="前の日" />
                <TextBlock x:Name="DayText" Text="2026年1月1日 (木)" VerticalAlignment="Center" Margin="14,0" MinWidth="170"
                           TextAlignment="Center" FontSize="17" FontWeight="Bold" Foreground="#20283A" />
                <Button x:Name="NextDayButton" Content="▶" Style="{StaticResource NavButton}" Click="NextDayClicked" ToolTip="次の日" />
                <Button x:Name="TodayButton" Content="今日" Style="{StaticResource NavButton}" Click="TodayClicked" Margin="10,0,0,0" />
            </StackPanel>
            <DatePicker x:Name="DayPicker" HorizontalAlignment="Right" VerticalAlignment="Center" Width="140"
                        SelectedDateChanged="DayPickerChanged" ToolTip="日付を選んで移動" />
        </Grid>

        <!-- Summary -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="この日の作業時間" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="DayTotalText" Text="0 分" Style="{StaticResource StatValue}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="いちばん長い連続作業" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="LongestText" Text="—" Style="{StaticResource StatValue}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="直近 7 日間の合計" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="WeekTotalText" Text="0 分" Style="{StaticResource StatValue}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Timeline + week chart -->
        <Grid Grid.Row="3" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="1 日のタイムライン" Style="{StaticResource SectionLabel}" />
                    <Grid Margin="0,14,0,0" Height="64">
                        <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="#EEF1F8" CornerRadius="8" />
                        <Canvas x:Name="TimelineCanvas" ClipToBounds="True" SizeChanged="TimelineSizeChanged" Background="Transparent" />
                        <Canvas x:Name="TimelineAxis" Grid.Row="1" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Width="10" Height="10" CornerRadius="3" Background="#5267C8" VerticalAlignment="Center" />
                        <TextBlock Text="作業" Margin="5,0,14,0" FontSize="11" Foreground="#68738A" />
                        <Border Width="10" Height="10" CornerRadius="3" Background="#3FAE8C" VerticalAlignment="Center" />
                        <TextBlock Text="作業中 (記録前)" Margin="5,0,0,0" FontSize="11" Foreground="#68738A" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="7 日間の推移" Style="{StaticResource SectionLabel}" />
                    <UniformGrid x:Name="WeekChart" Rows="1" Columns="7" Margin="0,10,0,0" Height="104" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Session list -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="20,16,8,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,12,0">
                    <TextBlock x:Name="ListTitle" Text="記録一覧" FontSize="15" FontWeight="Bold" Foreground="#20283A" VerticalAlignment="Center" />
                    <CheckBox x:Name="ShowShortBox" HorizontalAlignment="Right" VerticalAlignment="Center" Content="1 分未満の記録も表示"
                              FontSize="12" Foreground="#68738A" Checked="ShowShortChanged" Unchecked="ShowShortChanged" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,12,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="時間帯" Style="{StaticResource SectionLabel}" />
                    <TextBlock Grid.Column="1" Text="作業時間" Style="{StaticResource SectionLabel}" />
                    <TextBlock Grid.Column="2" Text="区切りのきっかけ" Style="{StaticResource SectionLabel}" />
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="SessionList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#EEF1F8" BorderThickness="0,1,0,0" Padding="0,9" Margin="0,0,12,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeRange}" FontSize="14" Foreground="#34405A" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontSize="14" Foreground="#20283A" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" HorizontalAlignment="Left" CornerRadius="10" Padding="9,3" Background="{Binding BadgeBackground}">
                                                <TextBlock Text="{Binding ReasonLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyText" Text="この日の記録はありません" Margin="0,24" HorizontalAlignment="Center"
                                   Foreground="#8790A2" FontSize="13" Visibility="Collapsed" />
                        <TextBlock x:Name="HiddenNote" Margin="0,8,12,0" Foreground="#A0A8B8" FontSize="11" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
