<Window x:Class="PauseCue.BreakOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized" Topmost="True"
        Background="#E8172033" ShowInTaskbar="False" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#5267C8" />
            <Setter Property="BorderBrush" Value="#5267C8" />
            <Setter Property="Padding" Value="18,13" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F7F8FC" />
            <Setter Property="BorderBrush" Value="#E1E5EF" />
            <Setter Property="Padding" Value="18,12" />
        </Style>
    </Window.Resources>
    <Grid>
        <Border Width="500" Padding="40" Background="White" CornerRadius="24"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect><DropShadowEffect BlurRadius="36" ShadowDepth="8" Opacity="0.22" Color="#07112B" /></Border.Effect>
            <StackPanel>
                <Border Width="52" Height="5" CornerRadius="3" Background="#DDE3F7" HorizontalAlignment="Left" Margin="0,0,0,24" />
                <TextBlock Text="少し休憩しましょう" FontSize="27" FontWeight="Bold" Foreground="#20283A" />
                <TextBlock x:Name="MessageText" Margin="0,12,0,26" FontSize="15" LineHeight="24" Foreground="#68738A" TextWrapping="Wrap" />
                <Button x:Name="BreakButton" Content="３分休憩しました · 長押し" Style="{StaticResource PrimaryButton}"
                        PreviewMouseLeftButtonDown="ActionButtonPressed" PreviewMouseLeftButtonUp="ActionButtonReleased"
                        LostMouseCapture="ActionButtonCaptureLost" />
                <Button x:Name="LaterButton" Margin="0,10,0,0" Style="{StaticResource QuietButton}"
                        PreviewMouseLeftButtonDown="ActionButtonPressed" PreviewMouseLeftButtonUp="ActionButtonReleased"
                        LostMouseCapture="ActionButtonCaptureLost" />
                <TextBlock x:Name="HoldHintText" Text="ボタンを押し続けてください" Margin="2,22,0,8" FontSize="12" Foreground="#68738A" />
                <ProgressBar x:Name="HoldProgress" Minimum="0" Maximum="1" Value="0" Height="7"
                             Background="#E9ECF4" Foreground="#6378D6" BorderThickness="0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
