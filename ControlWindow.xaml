<Window x:Class="PauseCue.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pause Cue" Height="700" Width="760" MinHeight="640" MinWidth="700"
        Background="#F4F6FB" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#68738A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#5267C8" />
            <Setter Property="BorderBrush" Value="#5267C8" />
        </Style>
    </Window.Resources>
    <Grid Margin="36,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Pause Cue" FontSize="28" FontWeight="Bold" Foreground="#20283A" />
                <TextBlock Text="集中を保ちながら、休憩のきっかけをつくります" Margin="0,5,0,0" Foreground="#68738A" FontSize="14" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E9EDFA" CornerRadius="20" Padding="12,7">
                <TextBlock Text="● 休憩リマインダー" Foreground="#5267C8" FontSize="12" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="18" Margin="0,25,0,18" Padding="24">
            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.06" Color="#263452" /></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#7183D7" CornerRadius="4" />
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <TextBlock Text="現在の状態" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="StatusText" Margin="0,6,0,0" FontSize="23" FontWeight="Bold" Foreground="#34405A" />
                    <TextBlock x:Name="DetailText" Margin="0,6,0,0" Foreground="#68738A" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="18" Padding="24">
            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.06" Color="#263452" /></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="リマインダー設定" FontSize="16" FontWeight="Bold" Foreground="#20283A" />
                    <TextBlock Text="作業時間や夜間の通知を調整できます" Margin="0,4,0,0" FontSize="12" Foreground="#8790A2" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="連続作業の目安" Style="{StaticResource SectionLabel}" />
                        <ComboBox x:Name="WorkIntervalBox" Margin="0,8,0,0" SelectionChanged="SettingsChanged">
                            <ComboBoxItem Content="30 分" Tag="30"/><ComboBoxItem Content="45 分" Tag="45"/><ComboBoxItem Content="60 分" Tag="60"/><ComboBoxItem Content="90 分" Tag="90"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="夜間モードの開始" Style="{StaticResource SectionLabel}" />
                        <ComboBox x:Name="NightStartBox" Margin="0,8,0,0" SelectionChanged="SettingsChanged">
                            <ComboBoxItem Content="23:00" Tag="23"/><ComboBoxItem Content="00:00" Tag="0"/><ComboBoxItem Content="01:00" Tag="1"/><ComboBoxItem Content="無効" Tag="-1"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,24,0,0" VerticalAlignment="Bottom">
                    <TextBlock Text="一時停止" Style="{StaticResource SectionLabel}" />
                    <WrapPanel Margin="0,9,0,0">
                        <Button Content="今すぐ休憩" Style="{StaticResource PrimaryAction}" Click="TakeBreakClicked" Margin="0,0,8,8" />
                        <Button Content="30 分" Tag="30" Click="PauseClicked" Margin="0,0,8,8" />
                        <Button Content="2 時間" Tag="120" Click="PauseClicked" Margin="0,0,8,8" />
                        <Button Content="一時停止を解除" Click="ResumeClicked" Margin="0,0,0,8" />
                    </WrapPanel>
                    <TextBlock Text="先送りは 5 分、15 分、30 分の順に延長します。入力内容は記録しません。" Margin="0,5,0,0" Foreground="#8790A2" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="2,18,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="WorkLogText" Text="本日の記録: 0 分" VerticalAlignment="Center" Foreground="#68738A" FontSize="13" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="UpdateButton" Content="更新を確認" Click="CheckForUpdatesClicked" Padding="12,8" Margin="0,0,8,0" />
                <Button Content="作業ログを開く" Click="OpenWorkLogClicked" Padding="12,8" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
